{
  //sets the trackers layout
  //more info: https://github.com/black-sliver/PopTracker/blob/master/doc/PACKS.md#layouts
  "tracker_vertical": {
    "type": "container",
    "background": "#000000",
    "content": {
      "type": "dock",
      "dropshadow": true,
      "content": [
        {
          "type": "dock",
          "dock": "bottom",
          "h_alignment": "center",
          "content": [
            {
              "type": "layout",
              "h_alignment": "center",
              "v_alignment": "center",
              "key": "item_grid_horizontal"
            }
          ]
        },
        {
          "type": "tabbed",
          "tabs": [
            {
              "title": "Full Tracker",
              "content": {
                "type": "map",
                "maps": [
                  "full"
                ]
              }
            }
          ]
        }
      ]
    }
  },
  "tracker_horizontal": {
    "type": "container",
    "background": "#000000",
    "content": {
      "type": "dock",
      "dropshadow": true,
      "content": [
        {
          "type": "dock",
          "dock": "left",
          "content": [
            {
              "type": "layout",
              "h_alignment": "center",
              "v_alignment": "center",
              "key": "item_grid_vertical"
            }
          ]
        },
        {
          "type": "tabbed",
          "tabs": [
            {
              "title": "Full Tracker",
              "content": {
                "type": "map",
                "maps": [
                  "full"
                ]
              }
            }
          ]
        }
      ]
    }
  }
}